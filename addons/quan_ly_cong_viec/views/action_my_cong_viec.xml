<odoo>
    <record id="view_cong_viec_tu_choi_wizard_form" model="ir.ui.view">
        <field name="name">cong_viec.tu_choi.wizard.form</field>
        <field name="model">cong_viec.tu_choi.wizard</field>
        <field name="arch" type="xml">
            <form string="Xác nhận từ chối">
                <group>
                    <field name="ly_do" placeholder="Tại sao bạn muốn từ chối công việc này?" required="1"/>
                </group>
                <footer>
                    <button name="confirm_tu_choi" string="Xác nhận Từ Chối" type="object" class="btn-danger"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_my_cong_viec" model="ir.actions.act_window">
        <field name="name">Công việc của tôi</field>
        <field name="res_model">cong_viec</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('nhan_vien_ids.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bạn chưa được giao công việc nào!
            </p>
        </field>
    </record>

    <record id="action_cong_viec" model="ir.actions.act_window">
        <field name="name">Tất cả công việc</field>
        <field name="res_model">cong_viec</field>
        <field name="view_mode">tree,form,graph,pivot</field>
    </record>
</odoo>