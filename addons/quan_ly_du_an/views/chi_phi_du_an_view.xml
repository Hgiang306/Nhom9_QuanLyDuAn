<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= TREE VIEW ================= -->
    <record id="chi_phi_du_an_tree_view" model="ir.ui.view">
        <field name="name">chi_phi_du_an.tree</field>
        <field name="model">chi_phi_du_an</field>
        <field name="arch" type="xml">
            <tree string="Chi Phí Dự Án">
                <field name="ten_chi_phi"/>
                <field name="du_an_id"/>
                <field name="ngan_sach_id"/>
                <field name="loai_chi_phi"/>
                <field name="so_tien" sum="Tổng Chi Phí"/>
                <field name="ngay_chi"/>
                <field name="nguoi_chi"/>
                <field name="trang_thai"/>
            </tree>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->
    <record id="chi_phi_du_an_form_view" model="ir.ui.view">
        <field name="name">chi_phi_du_an.form</field>
        <field name="model">chi_phi_du_an</field>
        <field name="arch" type="xml">
            <form string="Chi Phí Dự Án">

                <!-- ===== HEADER ===== -->
                <header>

                    <button name="action_duyet"
                            string="Duyệt"
                            type="object"
                            class="btn-primary"
                            groups="quan_ly_du_an.group_admin_du_an"
                            attrs="{
                                'invisible': ['|', 
                                    ('trang_thai', '!=', 'cho_duyet'),
                                    ('is_ngan_sach_am', '=', True)
                                ]
                            }"/>

                    <button name="action_tu_choi"
                            string="Từ Chối"
                            type="object"
                            class="btn-secondary"
                            groups="quan_ly_du_an.group_admin_du_an"
                            attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}"/>

                    <field name="trang_thai"
                           widget="statusbar"
                           statusbar_visible="cho_duyet,da_duyet,tu_choi"/>
                </header>

                <sheet>

                    <!-- ===== CẢNH BÁO ÂM NGÂN SÁCH ===== -->
                    <div class="alert alert-warning" role="alert"
                         attrs="{'invisible': [('is_ngan_sach_am', '=', False)]}">
                        ⚠️ Ngân sách dự án đã vượt mức cho phép và đang chờ admin duyệt âm.
                        Vui lòng duyệt ngân sách trước khi duyệt chi phí này.
                    </div>

                    <!-- ===== THÔNG TIN CHÍNH ===== -->
                    <group>
                        <group>
                            <field name="ten_chi_phi"/>
                            <field name="du_an_id"/>
                            <field name="ngan_sach_id"
                                   domain="[('du_an_id', '=', du_an_id)]"/>
                            <field name="loai_chi_phi"/>
                            <field name="so_tien"/>
                        </group>

                        <group>
                            <field name="ngay_chi"/>
                            <field name="nguoi_chi"/>
                            <field name="nguoi_duyet"
                                   readonly="1"
                                   groups="quan_ly_du_an.group_admin_du_an"/>
                            <field name="ngay_duyet"
                                   readonly="1"
                                   groups="quan_ly_du_an.group_admin_du_an"/>
                            <field name="is_ngan_sach_am" invisible="1"/>
                        </group>
                    </group>

                    <!-- ===== NOTEBOOK ===== -->
                    <notebook>

                        <page string="Mô Tả">
                            <field name="mo_ta"/>
                        </page>

                        <page string="Hóa Đơn / Chứng Từ">
                            <group>
                                <field name="hoa_don" filename="hoa_don_filename"/>
                                <field name="hoa_don_filename" invisible="1"/>
                            </group>
                        </page>

                        <page string="Ghi Chú Duyệt"
                              groups="quan_ly_du_an.group_admin_du_an"
                              attrs="{'invisible': [('trang_thai', '=', 'cho_duyet')]}">
                            <field name="ghi_chu_duyet"/>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================= SEARCH VIEW ================= -->
    <record id="chi_phi_du_an_search_view" model="ir.ui.view">
        <field name="name">chi_phi_du_an.search</field>
        <field name="model">chi_phi_du_an</field>
        <field name="arch" type="xml">
            <search string="Tìm Kiếm Chi Phí">
                <field name="ten_chi_phi"/>
                <field name="du_an_id"/>
                <field name="ngan_sach_id"/>

                <filter string="Chờ Duyệt"
                        name="cho_duyet"
                        domain="[('trang_thai', '=', 'cho_duyet')]"/>

                <filter string="Đã Duyệt"
                        name="da_duyet"
                        domain="[('trang_thai', '=', 'da_duyet')]"/>

                <filter string="Từ Chối"
                        name="tu_choi"
                        domain="[('trang_thai', '=', 'tu_choi')]"/>

                <group expand="0" string="Nhóm Theo">
                    <filter string="Dự Án" name="group_du_an" context="{'group_by': 'du_an_id'}"/>
                    <filter string="Ngân Sách" name="group_ngan_sach" context="{'group_by': 'ngan_sach_id'}"/>
                    <filter string="Loại Chi Phí" name="group_loai" context="{'group_by': 'loai_chi_phi'}"/>
                    <filter string="Trạng Thái" name="group_trang_thai" context="{'group_by': 'trang_thai'}"/>
                    <filter string="Ngày Chi" name="group_ngay" context="{'group_by': 'ngay_chi'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="chi_phi_du_an_action" model="ir.actions.act_window">
        <field name="name">Chi Phí Dự Án</field>
        <field name="res_model">chi_phi_du_an</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo chi phí dự án đầu tiên!
            </p>
            <p>
                Theo dõi và quản lý các khoản chi cho từng dự án và ngân sách.
            </p>
        </field>
    </record>

</odoo>