<odoo>
    <record id="view_van_ban_di_tree" model="ir.ui.view">
        <field name="name">qlvb.van_ban_di.tree</field>
        <field name="model">qlvb.van_ban_di</field>
        <field name="arch" type="xml">
            <tree>
                <field name="so_van_ban"/>
                <field name="ngay_di"/>
                <field name="trich_yeu"/>
            </tree>
        </field>
    </record>

    <record id="view_van_ban_di_form" model="ir.ui.view">
        <field name="name">qlvb.van_ban_di.form</field>
        <field name="model">qlvb.van_ban_di</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="so_van_ban"/>
                        <field name="ngay_di"/>
                        <field name="trich_yeu"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_van_ban_di" model="ir.actions.act_window">
        <field name="name">Văn bản đi</field>
        <field name="res_model">qlvb.van_ban_di</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_van_ban_di_search"/>
    </record>
</odoo>
