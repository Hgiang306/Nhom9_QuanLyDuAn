<odoo>
    <!-- TREE -->
    <record id="view_loai_van_ban_tree" model="ir.ui.view">
        <field name="name">qlvb.loai_van_ban.tree</field>
        <field name="model">qlvb.loai_van_ban</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="ghi_chu"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_loai_van_ban_form" model="ir.ui.view">
        <field name="name">qlvb.loai_van_ban.form</field>
        <field name="model">qlvb.loai_van_ban</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ghi_chu"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_loai_van_ban" model="ir.actions.act_window">
        <field name="name">Loại văn bản</field>
        <field name="res_model">qlvb.loai_van_ban</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
