<odoo>

    <!-- TREE -->
    <record id="view_van_ban_den_tree" model="ir.ui.view">
        <field name="name">qlvb.van_ban_den.tree</field>
        <field name="model">qlvb.van_ban_den</field>
        <field name="arch" type="xml">
            <tree>
                <field name="so_van_ban"/>
                <field name="ngay_den"/>
                <field name="nhan_vien_xu_ly_id"/>
            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_van_ban_den_form" model="ir.ui.view">
        <field name="name">qlvb.van_ban_den.form</field>
        <field name="model">qlvb.van_ban_den</field>
        <field name="arch" type="xml">
            <form string="Văn bản đến">
                <sheet>
                    <group>
                        <field name="so_van_ban"/>
                        <field name="ngay_den"/>
                        <field name="trich_yeu"/>
                    </group>

                    <group string="Nhân sự">
                        <field name="nhan_vien_xu_ly_id"/>
                        <field name="nhan_vien_ky_id"/>
                        <field name="nhan_vien_phoi_hop_ids"
                               widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_van_ban_den" model="ir.actions.act_window">
        <field name="name">Văn bản đến</field>
        <field name="res_model">qlvb.van_ban_den</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
