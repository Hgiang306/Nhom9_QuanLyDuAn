<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_chatbot_noiquy_chat" model="ir.actions.act_window">
        <field name="name">Hỏi Đáp AI</field>
        <field name="res_model">chatbot.noiquy.chat</field>
        <field name="view_mode">form,tree</field>
    </record>

    <menuitem id="menu_chatbot_root" name="Chatbot AI" sequence="10"/>
    <menuitem id="menu_chatbot_chat" name="Nhắn tin AI" parent="menu_chatbot_root" action="action_chatbot_noiquy_chat" sequence="10"/>

    <record id="view_chatbot_noiquy_chat_tree" model="ir.ui.view">
        <field name="name">chatbot.noiquy.chat.tree</field>
        <field name="model">chatbot.noiquy.chat</field>
        <field name="arch" type="xml">
            <tree string="Lịch sử">
                <field name="create_date"/>
                <field name="question"/>
            </tree>
        </field>
    </record>

    <record id="view_chatbot_noiquy_chat_form" model="ir.ui.view">
        <field name="name">chatbot.noiquy.chat.form</field>
        <field name="model">chatbot.noiquy.chat</field>
        <field name="arch" type="xml">
            <form string="Chatbot">
                <header>
                    <button name="action_ask" type="object" string="🚀 Gửi tin nhắn" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="question" placeholder="Nhập câu hỏi..." nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
</odoo>